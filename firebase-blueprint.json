{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account and profile information in SIBER-PM",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "name": { "type": "string", "description": "Full name with titles" },
        "username": { "type": "string", "description": "Username for login" },
        "nip": { "type": "string", "description": "18-digit employee identification number" },
        "email": { "type": "string", "description": "Official email address" },
        "role": { "type": "string", "enum": ["ADMIN_DINAS", "PENGAWAS", "KEPALA_SEKOLAH", "GURU"] },
        "schoolId": { "type": "string", "description": "ID of assigned school" },
        "schoolName": { "type": "string", "description": "Name of assigned school" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string", "description": "Creation timestamp ISO string" }
      },
      "required": ["id", "name", "role", "email"]
    },
    "School": {
      "title": "School",
      "description": "School institution information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique school ID" },
        "npsn": { "type": "string", "description": "National School Number" },
        "name": { "type": "string", "description": "School name" },
        "address": { "type": "string", "description": "Full address" },
        "subDistrict": { "type": "string", "description": "Kecamatan di Kabupaten Magetan" },
        "city": { "type": "string", "description": "City or regency" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "accreditation": { "type": "string", "description": "School accreditation level" },
        "principalName": { "type": "string", "description": "Name of principal" },
        "supervisorId": { "type": "string", "description": "Assigned supervisor ID" },
        "supervisorName": { "type": "string", "description": "Name of supervisor" }
      },
      "required": ["id", "npsn", "name"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher profile and assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique teacher ID" },
        "userId": { "type": "string", "description": "User account ID" },
        "nip": { "type": "string", "description": "NIP" },
        "name": { "type": "string", "description": "Full name with academic degree" },
        "schoolId": { "type": "string", "description": "Assigned school ID" },
        "schoolName": { "type": "string", "description": "School name" },
        "employmentStatus": { "type": "string", "description": "Status kepegawaian (PNS/PPPK/GTT/Honor Daerah)" },
        "rankGrade": { "type": "string", "description": "Pangkat dan Golongan Ruang" },
        "position": { "type": "string", "description": "Jabatan guru" },
        "subject": { "type": "string", "description": "Mata pelajaran yang diampu" },
        "educationLevel": { "type": "string", "description": "Pendidikan terakhir" },
        "phone": { "type": "string", "description": "Nomor HP / WhatsApp" },
        "email": { "type": "string", "description": "Email guru" }
      },
      "required": ["id", "name", "schoolId"]
    },
    "Supervisor": {
      "title": "Supervisor",
      "description": "School supervisor assigned by Dinas Pendidikan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique supervisor ID" },
        "userId": { "type": "string", "description": "User account ID" },
        "nip": { "type": "string", "description": "NIP Pengawas" },
        "name": { "type": "string", "description": "Nama pengawas" },
        "levels": { "type": "array", "description": "Jenjang binaan TK/SD/SMP" },
        "wilayahKecamatan": { "type": "array", "description": "Kecamatan binaan di Magetan" },
        "assignedSchoolIds": { "type": "array", "description": "Daftar ID sekolah binaan" },
        "assignedSchoolNames": { "type": "array", "description": "Daftar nama sekolah binaan" }
      },
      "required": ["id", "nip", "name"]
    },
    "SupervisionSchedule": {
      "title": "SupervisionSchedule",
      "description": "Supervision schedule and assessment workflow",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique supervision ID" },
        "teacherId": { "type": "string", "description": "Target teacher user ID" },
        "teacherName": { "type": "string", "description": "Target teacher name" },
        "schoolId": { "type": "string", "description": "School ID" },
        "schoolName": { "type": "string", "description": "School name" },
        "subject": { "type": "string", "description": "Subject being supervised" },
        "date": { "type": "string", "description": "Scheduled supervision date" },
        "time": { "type": "string", "description": "Scheduled time" },
        "status": { "type": "string", "enum": ["DIAJUKAN", "DISETUJUI", "DITOLAK", "SELESAI"] },
        "supervisorId": { "type": "string", "description": "Supervisor user ID" },
        "supervisorName": { "type": "string", "description": "Supervisor name" },
        "score": { "type": "number", "description": "Evaluation score" },
        "notes": { "type": "string", "description": "Supervision notes or feedback" }
      },
      "required": ["id", "teacherId", "schoolId", "status"]
    },
    "LessonPlan": {
      "title": "LessonPlan",
      "description": "Modul Ajar / Lesson Plan uploaded by teachers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique lesson plan ID" },
        "teacherId": { "type": "string", "description": "Owner teacher user ID" },
        "teacherName": { "type": "string", "description": "Teacher name" },
        "schoolId": { "type": "string", "description": "School ID" },
        "title": { "type": "string", "description": "Title of lesson plan" },
        "subject": { "type": "string", "description": "Subject name" },
        "grade": { "type": "string", "description": "Grade / Class" },
        "status": { "type": "string", "enum": ["DRAFT", "MENUNGGU_VERIFIKASI", "DISETUJUI", "PERLU_REVISI"] },
        "fileUrl": { "type": "string", "description": "URL to attached file or document" }
      },
      "required": ["id", "teacherId", "title", "subject", "status"]
    },
    "EducationYear": {
      "title": "EducationYear",
      "description": "Academic year and semester definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique year ID" },
        "name": { "type": "string", "description": "e.g. 2026/2027" },
        "semester": { "type": "string", "enum": ["Ganjil", "Genap"] },
        "startDate": { "type": "string", "description": "Start date" },
        "endDate": { "type": "string", "description": "End date" },
        "isActive": { "type": "boolean", "description": "Active flag" }
      },
      "required": ["id", "name", "semester"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System activity audit trail",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique log ID" },
        "userId": { "type": "string", "description": "User ID who performed the action" },
        "userName": { "type": "string", "description": "User name" },
        "userRole": { "type": "string", "description": "User role" },
        "activity": { "type": "string", "description": "Activity title" },
        "details": { "type": "string", "description": "Detailed log description" },
        "timestamp": { "type": "string", "description": "Timestamp string" }
      },
      "required": ["id", "userId", "activity", "timestamp"]
    },
    "ReflectiveNote": {
      "title": "ReflectiveNote",
      "description": "Teacher post-supervision self-reflection and pedagogical assessment records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique reflection note ID" },
        "supervisionId": { "type": "string", "description": "Linked supervision session ID" },
        "teacherId": { "type": "string", "description": "Author teacher ID" },
        "teacherName": { "type": "string", "description": "Author teacher name" },
        "teacherNip": { "type": "string", "description": "Teacher NIP" },
        "teacherEmail": { "type": "string", "description": "Teacher email" },
        "schoolId": { "type": "string", "description": "School ID" },
        "schoolName": { "type": "string", "description": "School name" },
        "supervisorId": { "type": "string", "description": "Supervisor ID" },
        "supervisorName": { "type": "string", "description": "Supervisor name" },
        "subject": { "type": "string", "description": "Subject taught" },
        "grade": { "type": "string", "description": "Grade / Class" },
        "topic": { "type": "string", "description": "Learning topic / material" },
        "supervisionDate": { "type": "string", "description": "Date supervision was held" },
        "reflectionDate": { "type": "string", "description": "Date reflection was completed" },
        "whatWentWell": { "type": "string", "description": "What went well during the lesson" },
        "challengesFaced": { "type": "string", "description": "Challenges and obstacles faced" },
        "studentResponse": { "type": "string", "description": "Student engagement and conceptual comprehension" },
        "actionPlanForNext": { "type": "string", "description": "Concrete improvements planned for next lesson" },
        "satisfactionScore": { "type": "number", "description": "Self satisfaction score (1-100)" },
        "supportNeeded": { "type": "string", "description": "Coaching/support requested from supervisor" },
        "supervisorFeedback": { "type": "string", "description": "Review and feedback by supervisor" },
        "supervisorFeedbackDate": { "type": "string", "description": "Date supervisor reviewed the reflection" },
        "status": { "type": "string", "enum": ["DRAFT", "DIKIRIM", "DITINJAU_PENGAWAS", "SELESAI"] },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "teacherId", "schoolId", "subject", "whatWentWell", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and credentials"
    },
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "Educational institutions registered in system"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Educator and teaching staff records"
    },
    "/supervisors/{supervisorId}": {
      "schema": "Supervisor",
      "description": "School supervisors and assigned regions"
    },
    "/supervisions/{supervisionId}": {
      "schema": "SupervisionSchedule",
      "description": "Supervision plans, execution records, and evaluations"
    },
    "/lessonPlans/{lessonPlanId}": {
      "schema": "LessonPlan",
      "description": "Uploaded teaching modules and verification records"
    },
    "/educationYears/{yearId}": {
      "schema": "EducationYear",
      "description": "Academic school years"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Security and activity audit trails"
    },
    "/reflectiveNotes/{noteId}": {
      "schema": "ReflectiveNote",
      "description": "Teacher post-supervision reflections reviewed by school supervisors"
    }
  }
}
