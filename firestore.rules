rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Allow read & write on SIBER-PM educational entities
    match /users/{userId} {
      allow read, write: if true;
    }

    match /schools/{schoolId} {
      allow read, write: if true;
    }

    match /teachers/{teacherId} {
      allow read, write: if true;
    }

    match /supervisors/{supervisorId} {
      allow read, write: if true;
    }

    match /supervisions/{supervisionId} {
      allow read, write: if true;
    }

    match /lessonPlans/{lessonPlanId} {
      allow read, write: if true;
    }

    match /educationYears/{yearId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
